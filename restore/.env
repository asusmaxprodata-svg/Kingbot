#########################################
#        KANG_BOT ENV CONFIG FILE       #
#  Ubah nilai di sebelah kanan tanda =  #
#########################################

# ========== TELEGRAM BOT CONFIG ==========
# Token Bot Telegram (dari BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxx-isi-token-kamu

# Chat ID tujuan notifikasi (bisa user ID atau group ID)
# Cara cek: kirim pesan ke bot @userinfobot di Telegram
TELEGRAM_CHAT_ID=123456789

# ========== TWILIO WHATSAPP CONFIG ==========
# SID Akun Twilio (dari Twilio Console)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Token Auth Twilio (dari Twilio Console)
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nomor WhatsApp tujuan dalam format internasional (contoh: +6281234567890)
WHATSAPP_TO=whatsapp:+6281234567890

# Nomor WhatsApp pengirim Twilio (default sandbox: +14155238886)
WHATSAPP_FROM=whatsapp:+14155238886

# ========== GENERAL CONFIG ==========
# Zona waktu untuk log & operasi bot
TZ=Asia/Jakarta

# Port untuk Streamlit
PORT=8501
